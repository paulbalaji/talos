{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complete",
    "summary",
    "findings",
    "existing_open_findings",
    "non_blocking_threads"
  ],
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "body"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "existing_open_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_blocking_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
