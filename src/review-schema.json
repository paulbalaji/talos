{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complete",
    "coverage_gaps",
    "evidence_requests",
    "summary",
    "findings",
    "existing_open_findings",
    "non_blocking_threads"
  ],
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "coverage_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start_line", "end_line", "line_contains"],
        "properties": {
          "path": { "type": "string" },
          "start_line": { "type": ["integer", "null"] },
          "end_line": { "type": ["integer", "null"] },
          "line_contains": { "type": ["string", "null"] }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "body"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "existing_open_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_blocking_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "disposition"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" },
          "disposition": { "type": "string", "enum": ["fixed", "rebutted", "nit", "deferred"] }
        }
      }
    }
  }
}
